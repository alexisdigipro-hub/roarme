{
  "appId": "com.themadlions.roarme",
  "appName": "RoarMe",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f1f1f6",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "sound",
        "alert"
      ]
    },
    "Keyboard": {
      "resize": "none",
      "resizeOnFullScreen": false
    }
  }
}
