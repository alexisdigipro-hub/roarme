{
  "name": "roar",
  "productName": "RoarMe",
  "version": "1.4.1",
  "description": "RoarMe for Mac and Windows: the chat in an app of its own",
  "author": "THEMADLIONS",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never && electron-builder --mac dmg --x64 --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.themadlions.roar",
    "productName": "RoarMe",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "trayTemplate.png",
      "trayTemplate@2x.png"
    ],
    "afterPack": "./adhoc-sign.js",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "identity": null,
      "artifactName": "RoarMe-Mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "RoarMe uses the camera for photos and video calls.",
        "NSMicrophoneUsageDescription": "RoarMe uses the microphone for voice messages and calls."
      }
    },
    "dmg": {
      "artifactName": "RoarMe-Mac-${arch}.${ext}",
      "title": "RoarMe"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RoarMe-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RoarMe"
    }
  }
}
